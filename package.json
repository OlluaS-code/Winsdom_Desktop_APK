{
  "name": "winsdom",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/OlluaS-code/Winsdom_Desktop_APK.git"
  },
  "main": "src/main.js",
  "author": "Saullo Moura Tavares",
  "license": "MIT",
  "scripts": {
    "start": "electron . --dev",
    "generate-icons": "electron-icon-maker --input=./public/img/Winsdom.png --output=./public/img/icons",
    "dist": "electron-builder --win",
    "publish-win": "electron-builder --win -p always"
  },
    "build": {
    "appId": "com.winsdom.app",
    "productName": "Winsdom",
    "directories": {
      "output": "dist_installer"
    },
    "win": {
      "target": ["nsis"],
      "icon": "public/img/icons/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Winsdom"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OlluaS-code",
        "repo": "Winsdom_Desktop_APK"
      }
    ]
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-icon-maker": "^0.0.5",
    "update-electron-app": "^3.0.0"
  },
  "dependencies": {
    "electron-reload": "^2.0.0-alpha.1"
  }
}
